# DexScreener API
VITE_DEXSCREENER_API_URL=https://api.dexscreener.com

# 0x Swap API
VITE_0X_API_URL=https://base.api.0x.org
VITE_0X_API_KEY=your_0x_api_key

# Supported Chain
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=base
VITE_RPC_URL=https://mainnet.base.org

# Token Configuration
VITE_THAI_TOKEN_ADDRESS=0x...your_thai_token_address
VITE_THAI_GATE_THRESHOLD=100

# Session Key Configuration
VITE_SESSION_KEY_ENABLED=true
VITE_SESSION_KEY_DURATION=86400
